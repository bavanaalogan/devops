pipeline {
    agent any

    environment {
        PYTHON = "C:/Users/bavan/AppData/Local/Python/bin/python.exe"
        STREAMLIT_SUPPRESS_PROMPT = 'true'
    }

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main', url: 'https://github.com/nithya1136/mushroom_classifier.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat '''
                %PYTHON% -m pip install --upgrade pip
                %PYTHON% -m pip install -r requirements.txt
                '''
            }
        }

        stage('Run Streamlit App') {
            steps {
                bat '''
                %PYTHON% -m streamlit run mushroom.py --server.headless true
                '''
            }
        }
    }
}
